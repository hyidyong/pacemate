# Stage 7 SSO provider registry (server-only, PUBLIC metadata ONLY — secrets
# live exclusively in Supabase Auth's provider config). JSON array of
# descriptors; empty/unset = SSO disabled. Example shape (dev only, no real
# institution values):
# PACEMATE_SSO_PROVIDERS=[{"schoolId":"<schools.id uuid>","slug":"example-univ","protocol":"oidc","providerRef":"custom:example-univ","issuer":"https://idp.example-univ.test","emailDomains":["example-univ.test"],"enabled":false,"policy":{"jit":{"enabled":false,"allowedRoles":[],"requireEmailVerified":true,"requireDomains":[]},"enforceSsoOnly":false}}]
PACEMATE_SSO_PROVIDERS=

# Codex F5. Demo credentials are NOT stored in the repository. The four demo
# accounts were rotated on 2026-08-14 after being published in the client
# bundle. Supply them at runtime, server-side only, as a JSON object of
# {identifier: password}. Leave BOTH of these unset in production: without them
# the demo login renders nothing and the sign-in action is inert.
# PACEMATE_ENABLE_DEMO_LOGIN=1
# PACEMATE_DEMO_PASSWORDS={"student1@pacemate.edu":"<rotated>","prof1@pacemate.edu":"<rotated>"}

# Required at runtime by the AI tutor, study guides and roadmap generation.
# OPENAI_API_KEY=sk-...
